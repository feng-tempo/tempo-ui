{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "lib": [
      "ES2020",
      "DOM"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "apps/expo-web/**/*.ts",
    "apps/expo-web/**/*.tsx"
  ]
}
