  "files": [
    "dist",
    "src"
  ],
  "peerDependencies": {
    "react": ">=18.3.1 <19",
    "react-dom": ">=18.3.1 <19",
    "react-native-web": ">=0.19.13 <0.20",
    "react-native": ">=0.76.9 <0.77",
    "react-native-gesture-handler": ">=2.20.2 <3",
    "@expo/vector-icons": ">=14 <15"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-gesture-handler": {
      "optional": true
    },
    "@expo/vector-icons": {
