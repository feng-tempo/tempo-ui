{
  "name": "@tempo/ui",
  "version": "0.1.0-dev.1",
  "type": "module",
  "private": true,
  "description": "Isolated staging library; no production migration",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./dist/web/index.js"
    },
    "./actions/button": {
      "types": "./dist/types/entries/button.d.ts",
      "react-native": "./src/entries/button.ts",
      "default": "./dist/web/actions/button.js"
    },
    "./fields/text": {
      "types": "./dist/types/entries/text.d.ts",
      "react-native": "./src/entries/text.ts",
      "default": "./dist/web/fields/text.js"
    },
    "./fields/number": {
      "types": "./dist/types/entries/number.d.ts",
      "react-native": "./src/entries/number.ts",
      "default": "./dist/web/fields/number.js"
    },
    "./fields/checkbox": {
      "types": "./dist/types/entries/checkbox.d.ts",
      "react-native": "./src/entries/checkbox.ts",
      "default": "./dist/web/fields/checkbox.js"
    },
    "./fields/dropdown": {
      "types": "./dist/types/entries/dropdown.d.ts",
      "react-native": "./src/entries/dropdown.ts",
      "default": "./dist/web/fields/dropdown.js"
