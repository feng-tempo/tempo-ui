{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "packages/ui/dist/types",
    "rootDir": "packages/ui/src",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "paths": {},
    "moduleSuffixes": [
      ".web",
      ""
    ]
  },
  "include": [
    "packages/ui/src/**/*.ts",
    "packages/ui/src/**/*.tsx"
  ],
  "exclude": [
    "packages/ui/src/platform/TextInput.tsx",
    "packages/ui/src/platform/Icons.tsx"
  ]
}